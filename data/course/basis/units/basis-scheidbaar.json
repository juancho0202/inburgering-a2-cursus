              "We hebben afgesproken."
            ],
            [
              "inleveren",
              "Ik lever het formulier in.",
              "Ik heb het ingeleverd."
            ],
            [
              "overstappen",
              "U stapt in Utrecht over.",
              "Ik ben overgestapt."
            ],
            [
              "meenemen",
              "Neem een jas mee.",
              "Ik heb een jas meegenomen."
            ],
            [
              "opbellen",
              "Ik bel je morgen op.",
              "Ik heb je opgebeld."
            ]
          ]
        },
        {
          "kind": "tip",
          "md": "Wacht op het laatste woordje! *Ik bel* ≠ *ik bel af* (afzeggen)."
        }
