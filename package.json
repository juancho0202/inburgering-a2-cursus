{
  "name": "inburgering-a2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "validate": "tsx server/scripts/validate-content.ts",
    "stats": "tsx server/scripts/content-stats.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "express": "^5.1.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
